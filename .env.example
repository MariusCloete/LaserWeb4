# LaserWeb4 Server Configuration
# Copy this to .env and modify as needed

# Web server port (default: 8000)
WEB_PORT=8000

# Server bind IP (0.0.0.0 = all interfaces)
IP=0.0.0.0

# Logging levels: 0=silent, 1=normal, 2=verbose, 3=debug
VERBOSE_LEVEL=1
LOG_LEVEL=0

# Firmware detection timing (in seconds)
FIRMWARE_WAIT_TIME=10
GRBL_WAIT_TIME=1
SMOOTHIE_WAIT_TIME=1
TINYG_WAIT_TIME=1

# Reset device on connect (1=yes, 0=no)
RESET_ON_CONNECT=1

# Buffer sizes for different firmware types
GRBL_BUFFER_SIZE=128
SMOOTHIE_BUFFER_SIZE=64
TINYG_BUFFER_SIZE=24
REPRAP_BUFFER_SIZE=2

# Position display decimals
DRO_DECIMALS=2

# Socket.IO settings
SOCKET_MAX_DATA_SIZE=100000000
SOCKET_CORS_ORIGIN=*
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000

# MPG (Manual Pulse Generator) Type: 0=disabled, 'HB03'=HB03, 'HB04'=HB04
MPG_TYPE=0
